<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallet_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />
        <TextView
            android:id="@+id/tv_wallet_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/address_prefix"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#F5F5F5" />
        <TextView
            android:id="@+id/tv_gold_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/gold_balance_default"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="24dp"
            android:layout_marginTop="12dp"
            android:background="#FFF3E0" />
        <Button
            android:id="@+id/btn_mine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mine_gold_pow"
            android:layout_marginTop="16dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/send_gold"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp" />
        <EditText
            android:id="@+id/et_to_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/receiver_address_hint"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background" />
        <EditText
            android:id="@+id/et_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/amount_hint"
            android:inputType="number"
            android:padding="8dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/editbox_background" />
        <Button
            android:id="@+id/btn_send_gold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_send"
            android:layout_marginTop="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transaction_history"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_transactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>